{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"noLib": true,
		"skipLibCheck": true,
		"typeRoots": ["node_modules/@rbxts"],
		"types": ["types", "compiler-types"]
	},
	"include": ["types/**/*.ts", "typings-test/**/*.ts"]
}
